{% comment %}
  WOWstampa custom reviews section.
  Richiede l'app standalone WOWstampa Reviews con endpoint /api/reviews.
{% endcomment %}

{% if product %}
  <section
    class="ws-reviews"
    data-ws-reviews
    data-endpoint="{{ section.settings.api_endpoint | escape }}"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-trustpilot-url="{{ section.settings.trustpilot_url | escape }}"
    data-star-empty="{{ section.settings.trustpilot_star_empty_url | escape }}"
    data-star-half="{{ section.settings.trustpilot_star_half_url | escape }}"
    data-star-full="{{ section.settings.trustpilot_star_full_url | escape }}"
  >
    <div class="ws-reviews__heading">
      <div>
        <span class="ws-reviews__eyebrow">★ Recensioni clienti</span>
        <h2>Clienti soddisfatti, <strong>stampe riuscite.</strong></h2>
        <p>Guarda cosa dicono aziende, negozi ed eventi che hanno già stampato con WowStampa.</p>
      </div>

      <a class="ws-reviews__brand" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
        <span>Eccezionale <b data-ws-average-label>4.9</b> su 5</span>
        <img
          src="{{ section.settings.trustpilot_logo_url | escape }}"
          alt="Trustpilot"
          loading="lazy"
          width="168"
          height="42"
        >
      </a>
    </div>

    <div class="ws-reviews__dashboard">
      <aside class="ws-reviews__rating-card">
        <div class="ws-reviews__score">
          <b data-ws-average>4.9</b>
          <span>★</span>
        </div>
        <strong data-ws-rating-label>Eccellente</strong>
        <div class="ws-reviews__trust-stars" data-ws-trust-stars aria-label="Valutazione Trustpilot">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
        </div>
        <a href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
          Basato su <span data-ws-total>0</span> recensioni
        </a>
        <span class="ws-reviews__verified">✓ Recensioni verificate</span>
        <small>Come vengono raccolte le recensioni?</small>
      </aside>

      <div class="ws-reviews__bars" aria-label="Distribuzione recensioni">
        <div data-ws-bar-row="5"><span>Eccellente</span><i><b style="width: 0%"></b></i><em>0%</em></div>
        <div data-ws-bar-row="4"><span>Molto buono</span><i><b style="width: 0%"></b></i><em>0%</em></div>
        <div data-ws-bar-row="3"><span>Medio</span><i><b style="width: 0%"></b></i><em>0%</em></div>
        <div data-ws-bar-row="2"><span>Scarso</span><i><b style="width: 0%"></b></i><em>0%</em></div>
        <div data-ws-bar-row="1"><span>Pessimo</span><i><b style="width: 0%"></b></i><em>0%</em></div>
      </div>

      <div class="ws-reviews__gallery" data-ws-gallery aria-label="Foto clienti">
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--count">
          <strong>+0</strong>
          <span>Foto dei clienti</span>
        </div>
      </div>
    </div>

    <div class="ws-reviews__filters" aria-label="Filtri recensioni">
      <button class="is-active" type="button" data-ws-filter="all">Tutte le recensioni</button>
      <button type="button" data-ws-filter="Qualità stampa">Qualità stampa</button>
      <button type="button" data-ws-filter="Consegna veloce">Consegna veloce</button>
      <button type="button" data-ws-filter="Assistenza">Assistenza</button>
      <button type="button" data-ws-filter="File e anteprima">File e anteprima</button>
      <button type="button" data-ws-filter="photos">▧ Foto clienti</button>
    </div>

    <div class="ws-reviews__cards" data-ws-review-cards>
      <p class="ws-reviews__empty">Caricamento recensioni...</p>
    </div>

    <a class="ws-reviews__cta" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
      Leggi tutte le recensioni su Trustpilot ↗
    </a>
  </section>

  <script>
    (function () {
      var root = document.querySelector('[data-ws-reviews][data-product-id="{{ product.id }}"]');
      if (!root || root.dataset.loaded === 'true') return;
      root.dataset.loaded = 'true';

      var endpoint = root.dataset.endpoint;
      var shop = root.dataset.shop;
      var productId = root.dataset.productId;
      var productHandle = root.dataset.productHandle;
      var cards = root.querySelector('[data-ws-review-cards]');
      var starUrls = {
        empty: root.dataset.starEmpty,
        half: root.dataset.starHalf,
        full: root.dataset.starFull
      };
      var allReviews = [];
      var activeFilter = 'all';

      if (!endpoint || !cards) return;

      var url = new URL(endpoint, window.location.origin);
      url.searchParams.set('shop', shop);
      url.searchParams.set('productId', productId);
      url.searchParams.set('productHandle', productHandle);
      url.searchParams.set('limit', '30');

      fetch(url.toString())
        .then(function (response) {
          if (!response.ok) throw new Error('Reviews unavailable');
          return response.json();
        })
        .then(function (data) {
          allReviews = Array.isArray(data.reviews) ? data.reviews : [];
          updateSummary(data);
          updateGallery(allReviews);
          renderCards();
        })
        .catch(function () {
          cards.innerHTML = '<p class="ws-reviews__empty">Recensioni momentaneamente non disponibili.</p>';
        });

      root.querySelectorAll('[data-ws-filter]').forEach(function (button) {
        button.addEventListener('click', function () {
          activeFilter = button.dataset.wsFilter || 'all';
          root.querySelectorAll('[data-ws-filter]').forEach(function (item) {
            item.classList.toggle('is-active', item === button);
          });
          renderCards();
        });
      });

      function updateSummary(data) {
        var average = Number(data.average || 0);
        var total = Number(data.total || 0);
        var averageText = average ? average.toFixed(1) : '0.0';

        setText('[data-ws-average]', averageText);
        setText('[data-ws-average-label]', averageText);
        setText('[data-ws-total]', total.toLocaleString('it-IT'));
        setTrustStars(total ? average : 0);
        setText('[data-ws-rating-label]', !total ? 'Nessuna recensione' : average >= 4.5 ? 'Eccellente' : average >= 4 ? 'Molto buono' : 'Buono');

        (data.distribution || []).forEach(function (item) {
          var row = root.querySelector('[data-ws-bar-row="' + item.rating + '"]');
          if (!row) return;
          var fill = row.querySelector('b');
          var label = row.querySelector('em');
          if (fill) fill.style.width = item.percent + '%';
          if (label) label.textContent = item.percent + '%';
        });
      }

      function updateGallery(reviews) {
        var gallery = root.querySelector('[data-ws-gallery]');
        if (!gallery) return;

        var photos = reviews.filter(function (review) { return review.photoUrl; });
        var firstPhotos = photos.slice(0, 3);
        gallery.innerHTML = '';

        firstPhotos.forEach(function (review, index) {
          var photo = document.createElement('div');
          photo.className = 'ws-reviews__photo' + (index === 0 ? ' ws-reviews__photo--large' : index === 1 ? ' ws-reviews__photo--wide' : '');
          photo.style.backgroundImage = 'linear-gradient(180deg, rgba(8,18,25,.08), rgba(8,18,25,.16)), url("' + escapeAttribute(review.photoUrl) + '")';
          gallery.appendChild(photo);
        });

        while (gallery.children.length < 3) {
          var emptyPhoto = document.createElement('div');
          emptyPhoto.className = 'ws-reviews__photo ws-reviews__photo--empty';
          gallery.appendChild(emptyPhoto);
        }

        var count = document.createElement('div');
        count.className = 'ws-reviews__photo ws-reviews__photo--count';
        count.innerHTML = '<strong>+' + photos.length + '</strong><span>Foto dei clienti</span>';
        gallery.appendChild(count);
      }

      function renderCards() {
        var visible = allReviews.filter(function (review) {
          if (activeFilter === 'all') return true;
          if (activeFilter === 'photos') return Boolean(review.photoUrl);
          return [review.tag, review.title, review.body].join(' ').toLowerCase().indexOf(activeFilter.toLowerCase()) !== -1;
        }).slice(0, 5);

        if (!visible.length) {
          cards.innerHTML = '<p class="ws-reviews__empty">Nessuna recensione per questo filtro.</p>';
          return;
        }

        cards.innerHTML = visible.map(function (review) {
          return (
            '<article class="ws-review-card">' +
              '<div>' +
                '<div class="ws-review-card__top">' +
                  '<span class="ws-reviews__stars">' + stars(review.rating) + '</span>' +
                  (review.verified ? '<span>✓ Verificata</span>' : '') +
                '</div>' +
                '<h3>' + escapeHtml(review.title) + '</h3>' +
                '<p>' + escapeHtml(review.body) + '</p>' +
              '</div>' +
              '<div class="ws-review-card__meta">' +
                '<span><b>' + escapeHtml(review.authorName) + '</b>' +
                (review.authorType ? '<small>' + escapeHtml(review.authorType) + '</small>' : '') +
                '</span>' +
                (review.tag ? '<em>' + escapeHtml(review.tag) + '</em>' : '') +
                '<time>' + relativeDate(review.reviewDate) + '</time>' +
              '</div>' +
            '</article>'
          );
        }).join('');
      }

      function setText(selector, text) {
        var element = root.querySelector(selector);
        if (element) element.textContent = text;
      }

      function stars(rating) {
        var value = Math.max(1, Math.min(5, Number(rating) || 5));
        return '★★★★★'.slice(0, value) + '☆☆☆☆☆'.slice(0, 5 - value);
      }

      function setTrustStars(rating) {
        var wrapper = root.querySelector('[data-ws-trust-stars]');
        if (!wrapper) return;
        var value = Math.max(0, Math.min(5, Number(rating) || 0));

        wrapper.querySelectorAll('img').forEach(function (image, index) {
          var progress = value - index;
          var src = starUrls.empty;

          if (progress >= 0.75) {
            src = starUrls.full;
          } else if (progress >= 0.25) {
            src = starUrls.half;
          }

          if (src) image.src = src;
        });

        wrapper.setAttribute('aria-label', value.toFixed(1) + ' su 5');
      }

      function relativeDate(value) {
        if (!value) return '';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '';
        var days = Math.max(0, Math.round((Date.now() - date.getTime()) / 86400000));
        if (days === 0) return 'oggi';
        if (days === 1) return 'ieri';
        if (days < 14) return days + ' giorni fa';
        var weeks = Math.round(days / 7);
        if (weeks < 9) return weeks + ' settimane fa';
        return date.toLocaleDateString('it-IT');
      }

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function escapeAttribute(value) {
        return String(value || '').replace(/"/g, '&quot;');
      }
    })();
  </script>
{% endif %}

{% stylesheet %}
  .ws-reviews {
    box-sizing: border-box;
    width: calc(100% - 32px);
    max-width: 1258px;
    margin: 42px auto 56px;
    padding: 28px;
    background: #ffffff;
    border: 1px solid #dfece5;
    border-radius: 18px;
    box-shadow: 0 18px 45px rgba(14, 48, 27, .11);
    color: #11251b;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .ws-reviews * {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  .ws-reviews__heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
    margin-bottom: 18px;
  }

  .ws-reviews__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: #eaf9f0;
    color: #05883d;
    font-size: 12px;
    font-weight: 950;
    text-transform: uppercase;
  }

  .ws-reviews__heading h2 {
    margin: 12px 0 6px;
    font-size: clamp(30px, 3.7vw, 48px);
    line-height: 1.02;
  }

  .ws-reviews__heading h2 strong {
    color: #10b955;
  }

  .ws-reviews__heading p {
    margin: 0;
    color: #64756b;
    font-size: 16px;
    line-height: 1.45;
  }

  .ws-reviews__brand {
    display: grid;
    justify-items: end;
    gap: 10px;
    color: #11251b;
    text-decoration: none;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 750;
  }

  .ws-reviews__brand img {
    display: block;
    width: 168px;
    max-width: 100%;
    height: auto;
  }

  .ws-reviews__score span {
    color: #10b955;
    font-size: 36px;
    line-height: 1;
  }

  .ws-reviews__dashboard {
    display: grid;
    grid-template-columns: 210px minmax(300px, 1fr) 460px;
    gap: 18px;
    align-items: stretch;
    margin-bottom: 20px;
  }

  .ws-reviews__rating-card,
  .ws-reviews__bars {
    min-height: 230px;
    border: 1px solid #e3eee7;
    border-radius: 15px;
    background: #ffffff;
  }

  .ws-reviews__rating-card {
    padding: 20px;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .ws-reviews__score {
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1;
  }

  .ws-reviews__score b {
    font-size: 56px;
  }

  .ws-reviews__rating-card a,
  .ws-reviews__rating-card small {
    color: #64756b;
    font-size: 12px;
    font-weight: 800;
  }

  .ws-reviews__verified {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 999px;
    background: #f4fbf7;
    border: 1px solid #deefe6;
    color: #05883d;
    font-size: 12px;
    font-weight: 900;
  }

  .ws-reviews__trust-stars {
    display: grid;
    grid-template-columns: repeat(5, 24px);
    gap: 3px;
    align-items: center;
    width: max-content;
  }

  .ws-reviews__trust-stars img {
    display: block;
    width: 24px;
    height: 24px;
  }

  .ws-reviews__stars {
    color: #ffb72b;
    font-weight: 950;
  }

  .ws-reviews__bars {
    display: grid;
    align-content: center;
    gap: 19px;
    padding: 20px 24px;
  }

  .ws-reviews__bars div {
    display: grid;
    grid-template-columns: 110px 1fr 42px;
    gap: 14px;
    align-items: center;
    color: #405248;
    font-size: 14px;
    font-weight: 850;
  }

  .ws-reviews__bars i {
    height: 11px;
    border-radius: 999px;
    background: #f0f4f2;
    overflow: hidden;
  }

  .ws-reviews__bars i b {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #16c75d, #11ad50);
    box-shadow: 0 6px 14px rgba(17, 173, 80, .22);
  }

  .ws-reviews__bars em {
    font-style: normal;
  }

  .ws-reviews__gallery {
    display: grid;
    grid-template-columns: 1.05fr .95fr .95fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
  }

  .ws-reviews__photo {
    min-height: 110px;
    border-radius: 11px;
    background-position: center;
    background-size: cover;
    overflow: hidden;
  }

  .ws-reviews__photo--large {
    grid-row: span 2;
    min-height: 230px;
  }

  .ws-reviews__photo--wide {
    grid-column: span 2;
  }

  .ws-reviews__photo--empty {
    background: linear-gradient(135deg, #d7eee0, #f4fff8 42%, #10b955);
  }

  .ws-reviews__photo--count {
    display: grid;
    place-items: center;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(0deg, rgba(4, 15, 12, .62), rgba(4, 15, 12, .62)), linear-gradient(135deg, #0b1e18, #28c969);
    font-weight: 950;
  }

  .ws-reviews__photo--count strong {
    display: block;
    font-size: 31px;
    line-height: 1;
  }

  .ws-reviews__photo--count span {
    display: block;
    margin-top: 5px;
    font-size: 13px;
  }

  .ws-reviews__filters {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 18px;
  }

  .ws-reviews__filters button {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e0e9e4;
    box-shadow: 0 8px 18px rgba(12, 42, 24, .04);
    color: #314338;
    font: inherit;
    font-size: 13px;
    font-weight: 850;
    text-align: center;
    cursor: pointer;
  }

  .ws-reviews__filters .is-active {
    border-color: transparent;
    background: linear-gradient(180deg, #18cf61, #08a848);
    color: #ffffff;
    box-shadow: 0 10px 20px rgba(16, 185, 85, .24);
  }

  .ws-reviews__cards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .ws-review-card {
    min-height: 228px;
    padding: 17px;
    border: 1px solid #e3eee7;
    border-radius: 13px;
    background: #ffffff;
    box-shadow: 0 10px 22px rgba(10, 48, 24, .045);
    display: grid;
    align-content: space-between;
    gap: 14px;
  }

  .ws-review-card__top,
  .ws-review-card__meta {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }

  .ws-review-card__top span:last-child {
    color: #4e6257;
    font-size: 11px;
    font-weight: 850;
  }

  .ws-review-card h3 {
    margin: 0 0 6px;
    color: #25392d;
    font-size: 16px;
    line-height: 1.3;
  }

  .ws-review-card p {
    margin: 0;
    color: #25392d;
    font-size: 14px;
    line-height: 1.5;
  }

  .ws-review-card__meta {
    justify-content: flex-start;
    flex-wrap: wrap;
    color: #64756b;
    font-size: 12px;
  }

  .ws-review-card__meta b,
  .ws-review-card__meta small {
    display: block;
  }

  .ws-review-card__meta em {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 4px 8px;
    color: #05883d;
    background: #eaf9f0;
    font-size: 11px;
    font-style: normal;
    font-weight: 900;
    white-space: nowrap;
  }

  .ws-reviews__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    border: 1px dashed #dfece5;
    border-radius: 13px;
    color: #64756b;
    text-align: center;
  }

  .ws-reviews__cta {
    width: fit-content;
    min-height: 48px;
    margin: 18px auto 0;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 2px solid rgba(16, 185, 85, .55);
    color: #05883d;
    background: #ffffff;
    font-size: 15px;
    font-weight: 950;
    text-decoration: none;
  }

  @media (max-width: 1040px) {
    .ws-reviews__dashboard {
      grid-template-columns: 1fr;
    }

    .ws-reviews__gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    .ws-reviews__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .ws-reviews {
      padding: 18px;
    }

    .ws-reviews__heading {
      flex-direction: column;
      align-items: stretch;
    }

    .ws-reviews__brand {
      justify-items: start;
    }

    .ws-reviews__filters,
    .ws-reviews__cards {
      grid-template-columns: 1fr;
    }

    .ws-reviews__gallery {
      grid-template-columns: 1fr 1fr;
    }

    .ws-reviews__photo--large,
    .ws-reviews__photo--wide {
      grid-column: span 2;
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WOW recensioni custom",
  "settings": [
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Endpoint recensioni app",
      "default": "https://wowstampa-reviews-app.onrender.com/api/reviews"
    },
    {
      "type": "text",
      "id": "trustpilot_url",
      "label": "URL Trustpilot",
      "default": "https://it.trustpilot.com/review/wowstampa.com"
    },
    {
      "type": "text",
      "id": "trustpilot_logo_url",
      "label": "Logo Trustpilot SVG",
      "default": "https://cdn.shopify.com/s/files/1/0555/0601/0321/files/Trustpilot_Logo__2022.svg?v=1779989756"
    },
    {
      "type": "text",
      "id": "trustpilot_star_empty_url",
      "label": "Stella Trustpilot grigia",
      "default": "https://cdn.shopify.com/s/files/1/0555/0601/0321/files/TRUSTPILOT_1.svg?v=1779990537"
    },
    {
      "type": "text",
      "id": "trustpilot_star_half_url",
      "label": "Stella Trustpilot metà",
      "default": "https://cdn.shopify.com/s/files/1/0555/0601/0321/files/TRUSTPILOT_3.svg?v=1779990536"
    },
    {
      "type": "text",
      "id": "trustpilot_star_full_url",
