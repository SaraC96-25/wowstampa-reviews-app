{% comment %}
  WOWstampa custom reviews section.
  Richiede l'app standalone WOWstampa Reviews con endpoint /api/reviews.
{% endcomment %}

{% if product %}
  <section
    class="ws-reviews"
    data-ws-reviews
    data-endpoint="{{ section.settings.api_endpoint | escape }}"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-trustpilot-url="{{ section.settings.trustpilot_url | escape }}"
    data-star-empty="{{ section.settings.trustpilot_star_empty_url | escape }}"
    data-star-half="{{ section.settings.trustpilot_star_half_url | escape }}"
    data-star-full="{{ section.settings.trustpilot_star_full_url | escape }}"
  >
    <div class="ws-reviews__heading">
      <div>
        <span class="ws-reviews__eyebrow">★ Recensioni clienti</span>
        <h2>Clienti soddisfatti, <strong>stampe riuscite.</strong></h2>
        <p>Guarda cosa dicono aziende, negozi ed eventi che hanno già stampato con WowStampa.</p>
      </div>

      <div class="ws-reviews__brand">
        <span>Eccezionale <b data-ws-average-label>4.9</b> su 5</span>
        <a href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
          <img
            src="{{ section.settings.trustpilot_logo_url | escape }}"
            alt="Trustpilot"
            loading="lazy"
            width="168"
            height="42"
          >
        </a>
        <a class="ws-reviews__trust-note" href="https://help.trustpilot.com/s/article/How-do-we-make-sure-reviews-are-trustworthy?language=it" target="_blank" rel="noopener">
          Le recensioni sono controllate da Trustpilot
        </a>
      </div>
    </div>

    <div class="ws-reviews__dashboard">
      <aside class="ws-reviews__rating-card">
        <div class="ws-reviews__score">
          <b data-ws-average>4.9</b>
          <span>★</span>
        </div>
        <strong data-ws-rating-label>Eccellente</strong>
        <div class="ws-reviews__trust-stars" data-ws-trust-stars aria-label="Valutazione Trustpilot">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
          <img src="{{ section.settings.trustpilot_star_empty_url | escape }}" alt="" loading="lazy" width="24" height="24">
        </div>
        <a href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
          Basato su <span data-ws-total>0</span> recensioni
        </a>
        <span class="ws-reviews__verified">✓ Recensioni verificate</span>
        <a class="ws-reviews__collection-link" href="https://help.trustpilot.com/s/article/How-do-we-make-sure-reviews-are-trustworthy?language=it" target="_blank" rel="noopener">
          Come vengono raccolte le recensioni?
        </a>
      </aside>

      <div class="ws-reviews__bars" aria-label="Filtra recensioni per valutazione">
        <button type="button" data-ws-bar-row="5" data-ws-rating-filter="5" aria-pressed="false"><span>Eccellente</span><i><b style="width: 0%"></b></i><em>0%</em></button>
        <button type="button" data-ws-bar-row="4" data-ws-rating-filter="4" aria-pressed="false"><span>Molto buono</span><i><b style="width: 0%"></b></i><em>0%</em></button>
        <button type="button" data-ws-bar-row="3" data-ws-rating-filter="3" aria-pressed="false"><span>Medio</span><i><b style="width: 0%"></b></i><em>0%</em></button>
        <button type="button" data-ws-bar-row="2" data-ws-rating-filter="2" aria-pressed="false"><span>Scarso</span><i><b style="width: 0%"></b></i><em>0%</em></button>
        <button type="button" data-ws-bar-row="1" data-ws-rating-filter="1" aria-pressed="false"><span>Pessimo</span><i><b style="width: 0%"></b></i><em>0%</em></button>
      </div>

      <div class="ws-reviews__gallery" data-ws-gallery aria-label="Foto clienti">
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--empty"></div>
        <div class="ws-reviews__photo ws-reviews__photo--count">
          <strong>+0</strong>
          <span>Foto dei clienti</span>
        </div>
      </div>
    </div>

    <div class="ws-reviews__filters" aria-label="Filtri recensioni">
      <button class="is-active" type="button" data-ws-filter="all">Tutte le recensioni</button>
      <button type="button" data-ws-filter="Qualità stampa">Qualità stampa</button>
      <button type="button" data-ws-filter="Consegna veloce">Consegna veloce</button>
      <button type="button" data-ws-filter="Assistenza">Assistenza</button>
      <button type="button" data-ws-filter="File e anteprima">File e anteprima</button>
      <button type="button" data-ws-filter="photos">▧ Foto clienti</button>
    </div>

    <div class="ws-reviews__slider" data-ws-review-slider>
      <button class="ws-reviews__slide-button ws-reviews__slide-button--prev" type="button" data-ws-slide-prev aria-label="Recensioni precedenti" hidden>‹</button>
      <div class="ws-reviews__cards is-empty" data-ws-review-cards>
        <p class="ws-reviews__empty">Caricamento recensioni...</p>
      </div>
      <button class="ws-reviews__slide-button ws-reviews__slide-button--next" type="button" data-ws-slide-next aria-label="Recensioni successive" hidden>›</button>
    </div>

    <a class="ws-reviews__cta" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">
      Leggi tutte le recensioni su Trustpilot ↗
    </a>

    <div class="ws-review-modal" data-ws-review-modal hidden>
      <div class="ws-review-modal__backdrop" data-ws-review-modal-close></div>
      <div class="ws-review-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ws-review-modal-title-{{ section.id }}">
        <button class="ws-review-modal__close" type="button" data-ws-review-modal-close aria-label="Chiudi recensione">×</button>
        <div class="ws-review-modal__top">
          <span data-ws-review-modal-stars></span>
          <span data-ws-review-modal-verified></span>
        </div>
        <h3 id="ws-review-modal-title-{{ section.id }}" data-ws-review-modal-title></h3>
        <p data-ws-review-modal-body></p>
        <div class="ws-review-modal__meta">
          <strong data-ws-review-modal-author></strong>
          <span data-ws-review-modal-tag></span>
          <time data-ws-review-modal-date></time>
        </div>
      </div>
    </div>

    <div class="ws-photo-modal" data-ws-photo-modal hidden>
      <div class="ws-photo-modal__backdrop" data-ws-photo-modal-close></div>
      <div class="ws-photo-modal__dialog" role="dialog" aria-modal="true" aria-label="Foto recensione cliente">
        <button class="ws-photo-modal__close" type="button" data-ws-photo-modal-close aria-label="Chiudi foto">×</button>
        <button class="ws-photo-modal__nav ws-photo-modal__nav--prev" type="button" data-ws-photo-prev aria-label="Foto precedente">‹</button>
        <div class="ws-photo-modal__media">
          <img data-ws-photo-main alt="Foto caricata da un cliente" loading="lazy">
        </div>
        <button class="ws-photo-modal__nav ws-photo-modal__nav--next" type="button" data-ws-photo-next aria-label="Foto successiva">›</button>
        <aside class="ws-photo-modal__review">
          <div class="ws-photo-modal__top">
            <span data-ws-photo-stars></span>
            <strong><span data-ws-photo-rating></span> su 5</strong>
          </div>
          <span class="ws-photo-modal__verified" data-ws-photo-verified></span>
          <h3 data-ws-photo-title></h3>
          <p data-ws-photo-body></p>
          <div class="ws-photo-modal__meta">
            <strong data-ws-photo-author></strong>
            <span data-ws-photo-tag></span>
            <time data-ws-photo-date></time>
          </div>
          <div class="ws-photo-modal__thumbs" data-ws-photo-thumbs aria-label="Altre foto della stessa recensione"></div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.querySelector('[data-ws-reviews][data-product-id="{{ product.id }}"]');
      if (!root || root.dataset.loaded === 'true') return;
      root.dataset.loaded = 'true';

      var endpoint = root.dataset.endpoint;
      var shop = root.dataset.shop;
      var productId = root.dataset.productId;
      var productHandle = root.dataset.productHandle;
      var cards = root.querySelector('[data-ws-review-cards]');
      var modal = root.querySelector('[data-ws-review-modal]');
      var photoModal = root.querySelector('[data-ws-photo-modal]');
      var slidePrevious = root.querySelector('[data-ws-slide-prev]');
      var slideNext = root.querySelector('[data-ws-slide-next]');
      var starUrls = {
        empty: root.dataset.starEmpty,
        half: root.dataset.starHalf,
        full: root.dataset.starFull
      };
      var allReviews = [];
      var activeFilter = 'all';
      var activeRating = null;
      var photoItems = [];
      var activePhotoIndex = 0;

      if (!endpoint || !cards) return;
      prepareReviewModal();
      preparePhotoModal();

      var url = new URL(endpoint, window.location.origin);
      url.searchParams.set('shop', shop);
      url.searchParams.set('productId', productId);
      url.searchParams.set('productHandle', productHandle);
      url.searchParams.set('limit', '50');
      url.searchParams.set('_ws_t', Date.now().toString());

      fetch(url.toString(), { cache: 'no-store' })
        .then(function (response) {
          if (!response.ok) throw new Error('Reviews unavailable');
          return response.json();
        })
        .then(function (data) {
          allReviews = Array.isArray(data.reviews) ? data.reviews : [];
          updateSummary(data);
          updateGallery(allReviews);
          renderCards();
        })
        .catch(function () {
          cards.innerHTML = '<p class="ws-reviews__empty">Recensioni momentaneamente non disponibili.</p>';
        });

      root.querySelectorAll('[data-ws-filter]').forEach(function (button) {
        button.addEventListener('click', function () {
          activeFilter = button.dataset.wsFilter || 'all';
          activeRating = null;
          root.querySelectorAll('[data-ws-filter]').forEach(function (item) {
            item.classList.toggle('is-active', item === button);
          });
          updateRatingFilterState();
          renderCards();
        });
      });

      root.querySelectorAll('[data-ws-rating-filter]').forEach(function (button) {
        button.addEventListener('click', function () {
          var rating = Number(button.dataset.wsRatingFilter || 0);
          activeRating = activeRating === rating ? null : rating;
          activeFilter = 'all';
          root.querySelectorAll('[data-ws-filter]').forEach(function (item) {
            item.classList.toggle('is-active', item.dataset.wsFilter === 'all');
          });
          updateRatingFilterState();
          renderCards();
        });
      });

      var gallery = root.querySelector('[data-ws-gallery]');
      if (gallery) {
        gallery.addEventListener('click', function (event) {
          var photo = event.target.closest('[data-ws-photo-index]');
          if (!photo) return;
          openPhotoModal(Number(photo.dataset.wsPhotoIndex || 0));
        });
      }

      if (slidePrevious) {
        slidePrevious.addEventListener('click', function () {
          scrollReviews(-1);
        });
      }

      if (slideNext) {
        slideNext.addEventListener('click', function () {
          scrollReviews(1);
        });
      }

      cards.addEventListener('scroll', updateSliderControls, { passive: true });
      window.addEventListener('resize', updateSliderControls);

      cards.addEventListener('click', function (event) {
        var card = event.target.closest('[data-ws-review-id]');
        if (card) openReviewModal(card.dataset.wsReviewId);
      });

      cards.addEventListener('keydown', function (event) {
        var card = event.target.closest('[data-ws-review-id]');
        if (!card || (event.key !== 'Enter' && event.key !== ' ')) return;
        event.preventDefault();
        openReviewModal(card.dataset.wsReviewId);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closePhotoModal();
          closeReviewModal();
        }
        if (!photoModal || photoModal.hidden) return;
        if (event.key === 'ArrowLeft') showAdjacentPhoto(-1);
        if (event.key === 'ArrowRight') showAdjacentPhoto(1);
      });

      function updateSummary(data) {
        var average = Number(data.average || 0);
        var total = Number(data.total || 0);
        var averageText = average ? average.toFixed(1) : '0.0';

        setText('[data-ws-average]', averageText);
        setText('[data-ws-average-label]', averageText);
        setText('[data-ws-total]', total.toLocaleString('it-IT'));
        setTrustStars(total ? average : 0);
        setText('[data-ws-rating-label]', !total ? 'Nessuna recensione' : average >= 4.5 ? 'Eccellente' : average >= 4 ? 'Molto buono' : 'Buono');

        (data.distribution || []).forEach(function (item) {
          var row = root.querySelector('[data-ws-bar-row="' + item.rating + '"]');
          if (!row) return;
          var fill = row.querySelector('b');
          var label = row.querySelector('em');
          if (fill) fill.style.width = item.percent + '%';
          if (label) label.textContent = item.percent + '%';
        });
      }

      function updateGallery(reviews) {
        var gallery = root.querySelector('[data-ws-gallery]');
        if (!gallery) return;

        photoItems = getPhotoItems(reviews);
        root.classList.toggle('ws-reviews--no-photos', photoItems.length === 0);

        if (!photoItems.length) {
          gallery.hidden = true;
          gallery.innerHTML = '';
          return;
        }

        gallery.hidden = false;
        var firstPhotos = photoItems.slice(0, 3);
        gallery.innerHTML = '';

        firstPhotos.forEach(function (item, index) {
          var photo = document.createElement('button');
          photo.type = 'button';
          photo.className = 'ws-reviews__photo' + (index === 0 ? ' ws-reviews__photo--large' : index === 1 ? ' ws-reviews__photo--wide' : '');
          photo.dataset.wsPhotoIndex = String(item.photoIndex);
          photo.setAttribute('aria-label', 'Apri foto recensione di ' + item.review.authorName);
          photo.style.backgroundImage = 'linear-gradient(180deg, rgba(8,18,25,.08), rgba(8,18,25,.16)), url("' + escapeAttribute(item.url) + '")';
          gallery.appendChild(photo);
        });

        while (gallery.children.length < 3) {
          var emptyPhoto = document.createElement('div');
          emptyPhoto.className = 'ws-reviews__photo ws-reviews__photo--empty';
          gallery.appendChild(emptyPhoto);
        }

        var count = document.createElement('button');
        count.type = 'button';
        count.className = 'ws-reviews__photo ws-reviews__photo--count';
        count.dataset.wsPhotoIndex = '0';
        count.setAttribute('aria-label', 'Apri gallery foto clienti');
        count.innerHTML = '<strong>+' + photoItems.length + '</strong><span>Foto dei clienti</span>';
        gallery.appendChild(count);
      }

      function renderCards() {
        var visible = allReviews.filter(function (review) {
          if (activeRating) return Number(review.rating) === activeRating;
          if (activeFilter === 'all') return true;
          if (activeFilter === 'photos') return Boolean(review.photoUrl);
          return [review.tag, review.title, review.body].join(' ').toLowerCase().indexOf(activeFilter.toLowerCase()) !== -1;
        });

        if (!visible.length) {
          cards.classList.add('is-empty');
          cards.innerHTML = '<p class="ws-reviews__empty">Nessuna recensione per questo filtro.</p>';
          updateSliderControls();
          return;
        }

        cards.classList.remove('is-empty');
        cards.innerHTML = visible.map(function (review) {
          return (
            '<article class="ws-review-card" role="button" tabindex="0" data-ws-review-id="' + escapeAttribute(review.id) + '" aria-label="Apri recensione completa">' +
              '<div>' +
                '<div class="ws-review-card__top">' +
                  trustStarsMarkup(review.rating, 'ws-review-card__stars') +
                  (review.verified ? '<span>✓ Verificata</span>' : '') +
                '</div>' +
                '<h3>' + escapeHtml(review.title) + '</h3>' +
                '<p>' + escapeHtml(review.body) + '</p>' +
              '</div>' +
              '<div class="ws-review-card__meta">' +
                '<span><b>' + escapeHtml(review.authorName) + '</b>' +
                (review.authorType ? '<small>' + escapeHtml(review.authorType) + '</small>' : '') +
                '</span>' +
                (review.tag ? '<em>' + escapeHtml(review.tag) + '</em>' : '') +
                '<time>' + relativeDate(review.reviewDate) + '</time>' +
              '</div>' +
            '</article>'
          );
        }).join('');
        cards.scrollLeft = 0;
        updateSliderControls();
      }

      function scrollReviews(direction) {
        if (!cards) return;
        cards.scrollBy({
          left: direction * Math.max(cards.clientWidth * 0.82, 260),
          behavior: 'smooth'
        });
      }

      function updateSliderControls() {
        if (!cards || !slidePrevious || !slideNext) return;
        var canSlide = cards.scrollWidth > cards.clientWidth + 4;
        var atStart = cards.scrollLeft <= 2;
        var atEnd = cards.scrollLeft + cards.clientWidth >= cards.scrollWidth - 2;

        slidePrevious.hidden = !canSlide;
        slideNext.hidden = !canSlide;
        slidePrevious.disabled = !canSlide || atStart;
        slideNext.disabled = !canSlide || atEnd;
      }

      function updateRatingFilterState() {
        root.querySelectorAll('[data-ws-rating-filter]').forEach(function (button) {
          var isActive = activeRating === Number(button.dataset.wsRatingFilter || 0);
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      function getPhotoItems(reviews) {
        var items = [];
        reviews.forEach(function (review) {
          reviewPhotos(review).forEach(function (url) {
            items.push({
              photoIndex: items.length,
              review: review,
              url: url
            });
          });
        });
        return items;
      }

      function reviewPhotos(review) {
        return String(review.photoUrl || '')
          .split(/[\n;,]+/)
          .map(function (url) { return url.trim(); })
          .filter(Boolean);
      }

      function openPhotoModal(index) {
        if (!photoModal || !photoItems.length) return;
        activePhotoIndex = Math.max(0, Math.min(photoItems.length - 1, Number(index) || 0));
        renderPhotoModal();
        photoModal.hidden = false;
        photoModal.removeAttribute('hidden');
        photoModal.style.display = 'grid';
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        root.classList.add('ws-reviews--photo-modal-open');
        var closeButton = photoModal.querySelector('[data-ws-photo-modal-close]');
        if (closeButton) closeButton.focus();
      }

      function renderPhotoModal() {
        if (!photoModal || !photoItems.length) return;
        var item = photoItems[activePhotoIndex];
        if (!item) return;
        var review = item.review;
        var rating = Number(review.rating || 0);
        var mainImage = photoModal.querySelector('[data-ws-photo-main]');
        var thumbs = photoModal.querySelector('[data-ws-photo-thumbs]');
        var reviewItems = photoItems.filter(function (photo) {
          return String(photo.review.id) === String(review.id);
        });

        if (mainImage) {
          mainImage.src = item.url;
          mainImage.alt = review.title ? 'Foto recensione: ' + review.title : 'Foto recensione cliente';
        }

        setPhotoHtml('[data-ws-photo-stars]', trustStarsMarkup(rating, 'ws-photo-modal__stars'));
        setPhotoText('[data-ws-photo-rating]', rating.toFixed(1));
        setPhotoText('[data-ws-photo-verified]', review.verified ? '✓ Recensione verificata' : '');
        setPhotoText('[data-ws-photo-title]', review.title);
        setPhotoText('[data-ws-photo-body]', review.body);
        setPhotoText('[data-ws-photo-author]', review.authorName);
        setPhotoText('[data-ws-photo-tag]', review.tag || review.authorType || '');
        setPhotoText('[data-ws-photo-date]', relativeDate(review.reviewDate));
        togglePhotoElement('[data-ws-photo-verified]', Boolean(review.verified));
        togglePhotoElement('[data-ws-photo-tag]', Boolean(review.tag || review.authorType));
        togglePhotoElement('[data-ws-photo-date]', Boolean(relativeDate(review.reviewDate)));

        if (thumbs) {
          thumbs.innerHTML = reviewItems.map(function (photo) {
            return (
              '<button type="button" data-ws-photo-thumb-index="' + photo.photoIndex + '" class="' + (photo.photoIndex === activePhotoIndex ? 'is-active' : '') + '" aria-label="Mostra questa foto">' +
                '<img src="' + escapeAttribute(photo.url) + '" alt="" loading="lazy">' +
              '</button>'
            );
          }).join('');
          thumbs.hidden = reviewItems.length <= 1;
        }

        updatePhotoNavState();
      }

      function showAdjacentPhoto(direction) {
        if (!photoItems.length) return;
        activePhotoIndex = (activePhotoIndex + direction + photoItems.length) % photoItems.length;
        renderPhotoModal();
      }

      function updatePhotoNavState() {
        if (!photoModal) return;
        photoModal.querySelectorAll('[data-ws-photo-prev], [data-ws-photo-next]').forEach(function (button) {
          button.disabled = photoItems.length <= 1;
        });
      }

      function closePhotoModal() {
        if (!photoModal || photoModal.hidden) return;
        photoModal.hidden = true;
        photoModal.setAttribute('hidden', '');
        photoModal.style.display = 'none';
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        root.classList.remove('ws-reviews--photo-modal-open');
      }

      function preparePhotoModal() {
        if (!photoModal) return;
        document.body.appendChild(photoModal);
        photoModal.addEventListener('click', function (event) {
          if (event.target.closest('[data-ws-photo-modal-close]')) {
            event.preventDefault();
            event.stopPropagation();
            closePhotoModal();
          }

          if (event.target.closest('[data-ws-photo-prev]')) {
            event.preventDefault();
            showAdjacentPhoto(-1);
          }

          if (event.target.closest('[data-ws-photo-next]')) {
            event.preventDefault();
            showAdjacentPhoto(1);
          }

          var thumb = event.target.closest('[data-ws-photo-thumb-index]');
          if (thumb) {
            event.preventDefault();
            activePhotoIndex = Number(thumb.dataset.wsPhotoThumbIndex || activePhotoIndex);
            renderPhotoModal();
          }
        });
      }

      function openReviewModal(reviewId) {
        if (!modal) return;
        var review = allReviews.find(function (item) { return String(item.id) === String(reviewId); });
        if (!review) return;

        setModalHtml('[data-ws-review-modal-stars]', trustStarsMarkup(review.rating, 'ws-review-modal__stars'));
        setModalText('[data-ws-review-modal-verified]', review.verified ? '✓ Verificata' : '');
        setModalText('[data-ws-review-modal-title]', review.title);
        setModalText('[data-ws-review-modal-body]', review.body);
        setModalText('[data-ws-review-modal-author]', review.authorName);
        setModalText('[data-ws-review-modal-tag]', review.tag || review.authorType || '');
        setModalText('[data-ws-review-modal-date]', relativeDate(review.reviewDate));

        modal.hidden = false;
        modal.removeAttribute('hidden');
        modal.style.display = 'grid';
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        root.classList.add('ws-reviews--modal-open');
        var closeButton = modal.querySelector('[data-ws-review-modal-close]');
        if (closeButton) closeButton.focus();
      }

      function closeReviewModal() {
        if (!modal) return;
        modal.hidden = true;
        modal.setAttribute('hidden', '');
        modal.style.display = 'none';
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        root.classList.remove('ws-reviews--modal-open');
      }

      function prepareReviewModal() {
        if (!modal) return;
        document.body.appendChild(modal);
        modal.style.position = 'fixed';
        modal.style.inset = '0';
        modal.style.zIndex = '999999';
        modal.style.display = 'none';
        modal.style.placeItems = 'center';
        modal.style.padding = '20px';
        modal.addEventListener('click', function (event) {
          if (event.target.closest('[data-ws-review-modal-close]')) {
            event.preventDefault();
            event.stopPropagation();
            closeReviewModal();
          }
        });

        var backdrop = modal.querySelector('.ws-review-modal__backdrop');
        if (backdrop) {
          backdrop.style.position = 'absolute';
          backdrop.style.inset = '0';
          backdrop.style.background = 'rgba(8, 22, 15, .52)';
          backdrop.style.backdropFilter = 'blur(5px)';
          backdrop.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            closeReviewModal();
          });
        }

        var dialog = modal.querySelector('.ws-review-modal__dialog');
        if (dialog) {
          dialog.style.position = 'relative';
          dialog.style.zIndex = '1';
          dialog.style.boxSizing = 'border-box';
          dialog.style.width = 'min(620px, 100%)';
          dialog.style.maxHeight = 'min(760px, calc(100vh - 40px))';
          dialog.style.overflow = 'auto';
          dialog.style.padding = '28px';
          dialog.style.border = '1px solid #dbece2';
          dialog.style.borderRadius = '18px';
          dialog.style.background = '#ffffff';
          dialog.style.boxShadow = '0 26px 70px rgba(5, 28, 15, .24)';
        }

        var close = modal.querySelector('.ws-review-modal__close');
        if (close) {
          close.style.position = 'absolute';
          close.style.top = '14px';
          close.style.right = '14px';
          close.style.width = '34px';
          close.style.height = '34px';
          close.style.border = '1px solid #dcebe3';
          close.style.borderRadius = '999px';
          close.style.background = '#ffffff';
          close.style.color = '#21382b';
          close.style.cursor = 'pointer';
          close.style.fontSize = '24px';
          close.style.lineHeight = '1';
          close.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            closeReviewModal();
          });
        }
      }

      function setModalText(selector, text) {
        var element = modal ? modal.querySelector(selector) : null;
        if (element) element.textContent = text || '';
      }

      function setModalHtml(selector, html) {
        var element = modal ? modal.querySelector(selector) : null;
        if (element) element.innerHTML = html || '';
      }

      function setPhotoText(selector, text) {
        var element = photoModal ? photoModal.querySelector(selector) : null;
        if (element) element.textContent = text || '';
      }

      function setPhotoHtml(selector, html) {
        var element = photoModal ? photoModal.querySelector(selector) : null;
        if (element) element.innerHTML = html || '';
      }

      function togglePhotoElement(selector, visible) {
        var element = photoModal ? photoModal.querySelector(selector) : null;
        if (element) element.hidden = !visible;
      }

      function setText(selector, text) {
        var element = root.querySelector(selector);
        if (element) element.textContent = text;
      }

      function trustStarsMarkup(rating, className) {
        var value = Math.max(0, Math.min(5, Number(rating) || 0));
        var size = className.indexOf('modal') !== -1 ? 20 : 16;
        var html = '<span class="' + className + '" aria-label="' + value.toFixed(1) + ' su 5" style="display:grid;grid-template-columns:repeat(5,' + size + 'px);gap:2px;align-items:center;width:max-content;">';

        for (var index = 0; index < 5; index += 1) {
          var progress = value - index;
          var src = starUrls.empty;

          if (progress >= 0.75) {
            src = starUrls.full;
          } else if (progress >= 0.25) {
            src = starUrls.half;
          }

          html += '<img src="' + escapeAttribute(src) + '" alt="" loading="lazy" width="' + size + '" height="' + size + '" style="display:block;width:' + size + 'px;height:' + size + 'px;">';
        }

        return html + '</span>';
      }

      function setTrustStars(rating) {
        var wrapper = root.querySelector('[data-ws-trust-stars]');
        if (!wrapper) return;
        var value = Math.max(0, Math.min(5, Number(rating) || 0));

        wrapper.querySelectorAll('img').forEach(function (image, index) {
          var progress = value - index;
          var src = starUrls.empty;

          if (progress >= 0.75) {
            src = starUrls.full;
          } else if (progress >= 0.25) {
            src = starUrls.half;
          }

          if (src) image.src = src;
        });

        wrapper.setAttribute('aria-label', value.toFixed(1) + ' su 5');
      }

      function relativeDate(value) {
        if (!value) return '';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '';
        var days = Math.max(0, Math.round((Date.now() - date.getTime()) / 86400000));
        if (days === 0) return 'oggi';
        if (days === 1) return 'ieri';
        if (days < 14) return days + ' giorni fa';
        var weeks = Math.round(days / 7);
        if (weeks < 9) return weeks + ' settimane fa';
        return date.toLocaleDateString('it-IT');
      }

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function escapeAttribute(value) {
        return String(value || '').replace(/"/g, '&quot;');
      }
    })();
  </script>
