    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    padding-right: 42px;
  }

  .ws-photo-modal__top strong {
    color: #4e6257;
    font-size: 13px;
    white-space: nowrap;
  }

  .ws-photo-modal__verified {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 6px 10px;
    border-radius: 999px;
    color: #05883d;
    background: #eaf9f0;
    font-size: 12px;
    font-weight: 900;
  }

  .ws-photo-modal__review h3 {
    margin: 2px 0 0;
    color: #17281f;
    font-size: 24px;
    line-height: 1.22;
  }

  .ws-photo-modal__review p {
    margin: 0;
    color: #25392d;
    font-size: 15px;
    line-height: 1.58;
    white-space: pre-line;
  }

  .ws-photo-modal__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    align-items: center;
    color: #64756b;
    font-size: 13px;
  }

  .ws-photo-modal__meta span {
    border-radius: 999px;
    padding: 5px 9px;
    color: #05883d;
    background: #eaf9f0;
    font-weight: 900;
  }

  .ws-photo-modal__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 6px;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .ws-photo-modal__thumbs button {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    background: #f3f8f5;
    cursor: pointer;
    overflow: hidden;
  }

  .ws-photo-modal__thumbs button.is-active {
    border-color: #13b957;
  }

  .ws-photo-modal__thumbs img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ws-reviews__cta {
    width: fit-content;
    min-height: 48px;
    margin: 18px auto 0;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 2px solid rgba(16, 185, 85, .55);
    color: #05883d;
    background: #ffffff;
    font-size: 15px;
    font-weight: 950;
    white-space: nowrap;
    text-decoration: none;
  }

  @media (max-width: 1040px) {
    .ws-reviews__dashboard {
      grid-template-columns: 1fr;
    }

    .ws-reviews__gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    .ws-reviews__cards {
      grid-auto-columns: calc((100% - 14px) / 2);
    }

    .ws-photo-modal__dialog {
      grid-template-columns: 1fr;
      overflow: auto;
    }

    .ws-photo-modal__media {
      min-height: 420px;
    }

    .ws-photo-modal__review {
      max-height: none;
    }

    .ws-photo-modal__nav--next {
      right: 18px;
    }
  }

  @media (max-width: 720px) {
    .ws-reviews {
      width: calc(100% - 20px);
      margin: 28px auto 36px;
      padding: 16px;
      border-radius: 15px;
    }

    .ws-reviews__heading {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      margin-bottom: 14px;
    }

    .ws-reviews__eyebrow {
      min-height: 22px;
      padding: 0 8px;
      font-size: 10px;
    }

    .ws-reviews__heading h2 {
      margin: 8px 0 4px;
      font-size: 26px;
      line-height: 1.05;
    }

    .ws-reviews__heading p {
      font-size: 13px;
      line-height: 1.35;
    }

    .ws-reviews__brand {
      display: flex;
      flex-wrap: wrap;
      justify-items: start;
      align-items: center;
      gap: 7px 10px;
      font-size: 12px;
      white-space: normal;
    }

    .ws-reviews__brand img {
      width: 122px;
    }

    .ws-reviews__trust-note {
      flex-basis: 100%;
      font-size: 11px;
    }

    .ws-reviews__dashboard,
    .ws-reviews--no-photos .ws-reviews__dashboard {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }

    .ws-reviews__rating-card,
    .ws-reviews__bars {
      min-height: 0;
      border-radius: 12px;
    }

    .ws-reviews__rating-card {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 7px 12px;
      padding: 14px;
    }

    .ws-reviews__score {
      grid-row: span 2;
      gap: 7px;
    }

    .ws-reviews__score b {
      font-size: 42px;
    }

    .ws-reviews__score span {
      font-size: 25px;
    }

    .ws-reviews__rating-card > strong {
      font-size: 14px;
      align-self: end;
    }

    .ws-reviews__trust-stars {
      grid-template-columns: repeat(5, 20px);
      gap: 2px;
    }

    .ws-reviews__trust-stars img {
      width: 20px;
      height: 20px;
    }

    .ws-reviews__rating-card a {
      font-size: 11px;
    }

    .ws-reviews__verified {
      margin-top: 0;
      padding: 6px 8px;
      font-size: 11px;
    }

    .ws-reviews__collection-link {
      display: none;
    }

    .ws-reviews__bars {
      gap: 9px;
      padding: 13px 14px;
    }

    .ws-reviews__bars button {
      grid-template-columns: 88px 1fr 34px;
      gap: 8px;
      font-size: 12px;
    }

    .ws-reviews__bars i {
      height: 8px;
    }

    .ws-reviews__photo {
      min-height: 86px;
      border-radius: 9px;
    }

    .ws-reviews__photo--large,
    .ws-reviews__photo--wide {
      min-height: 112px;
    }

    .ws-reviews__filters {
      display: flex;
      gap: 8px;
      margin: 0 -16px 12px;
      padding: 0 16px 4px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }

    .ws-reviews__filters button {
      flex: 0 0 auto;
      min-height: 36px;
      padding: 0 13px;
      font-size: 12px;
      scroll-snap-align: start;
      box-shadow: none;
    }

    .ws-reviews__filters button:nth-child(n+5) {
      display: none;
    }

    .ws-reviews__cards {
      grid-auto-columns: minmax(245px, 84%);
      gap: 10px;
      margin: 0 -16px;
      padding: 0 16px 8px;
      scroll-padding: 16px;
    }

    .ws-reviews__slide-button {
      display: none;
    }

    .ws-review-card {
      min-height: 0;
      padding: 14px;
      border-radius: 12px;
      gap: 10px;
      box-shadow: 0 8px 18px rgba(10, 48, 24, .05);
    }

    .ws-review-card__top {
      align-items: flex-start;
    }

    .ws-review-card__top span:last-child {
      font-size: 10px;
    }

    .ws-review-card__stars {
      grid-template-columns: repeat(5, 15px);
    }

    .ws-review-card__stars img {
      width: 15px;
      height: 15px;
    }

    .ws-review-card h3 {
      margin-bottom: 5px;
      padding-top: 8px;
      font-size: 17px;
      line-height: 1.18;
    }

    .ws-review-card p {
      font-size: 13px;
      line-height: 1.42;
      -webkit-line-clamp: 3;
    }

    .ws-review-card__meta {
      gap: 8px;
      font-size: 11px;
    }

    .ws-review-card__meta em {
      min-height: 22px;
      padding: 3px 7px;
      font-size: 10px;
    }

    .ws-reviews__cta {
      width: 100%;
      min-height: 42px;
      margin-top: 13px;
      padding: 0 14px;
      font-size: 13px;
    }

    .ws-review-modal {
      padding: 12px;
    }

    .ws-photo-modal {
      padding: 10px;
    }

    .ws-photo-modal__dialog {
      max-height: calc(100vh - 20px);
      border-radius: 15px;
    }

    .ws-photo-modal__media {
      min-height: 300px;
      max-height: 46vh;
    }

    .ws-photo-modal__media img {
      max-height: 46vh;
    }

    .ws-photo-modal__review {
      gap: 10px;
      padding: 18px;
    }

    .ws-photo-modal__top {
      padding-right: 42px;
    }

    .ws-photo-modal__review h3 {
      font-size: 20px;
    }

    .ws-photo-modal__review p {
      font-size: 14px;
      line-height: 1.5;
    }

    .ws-photo-modal__nav {
      width: 38px;
      height: 38px;
      font-size: 28px;
    }

    .ws-photo-modal__close {
      top: 12px;
      right: 12px;
    }

    .ws-photo-modal__thumbs button {
      flex-basis: 54px;
      width: 54px;
      height: 54px;
    }

    .ws-review-modal__dialog {
      padding: 22px 18px;
      border-radius: 15px;
    }

    .ws-review-modal h3 {
      font-size: 20px;
    }

    .ws-review-modal p {
      font-size: 14px;
      line-height: 1.55;
    }

    .ws-reviews__gallery {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .ws-reviews__photo--large,
    .ws-reviews__photo--wide {
      grid-column: span 2;
      grid-row: auto;
    }
  }
{% endstylesheet %}

